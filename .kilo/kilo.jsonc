{
  "$schema": "https://app.kilo.ai/config.json",
  "indexing": {
    "enabled": false,
    "provider": "kilo",
    "model": "mistralai/mistral-embed-2312"
  },
  "mcp": {
    "japaconnect": {
      "type": "remote",
      "url": "http://localhost:8080/api/v1/mcp",
      "headers": {
        "X-API-Key": "${JC_MCP_API_KEY}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  }
}
