  </sitemap>
  <sitemap>
    <loc>https://japaconnect.com/sitemap-tags.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://japaconnect.com/sitemap-users.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://japaconnect.com/sitemap-images.xml</loc>
  </sitemap>
