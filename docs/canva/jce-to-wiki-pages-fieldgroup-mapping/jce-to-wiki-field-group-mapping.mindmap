            "collapsed": false
          },
          {
            "id": "1792461587214",
            "text": "same field-group name under [[compare]] and /wiki = the link",
            "children": [],
            "x": 580,
            "parent": "1792461587219",
            "y": 11270,
            "collapsed": false
          },
          {
            "id": "1792461587215",
            "text": "wiki type = entity kind with own pages; nests under a parent type (any depth)",
            "children": [],
            "x": 580,
            "parent": "1792461587219",
            "y": 11340,
            "collapsed": false
          },
          {
            "id": "1792461587216",
            "text": "wiki-type compare -> overview group only (PRIMARY)",
            "children": [],
            "x": 580,
            "parent": "1792461587219",
            "y": 11410,
            "collapsed": false
          },
          {
            "id": "1792461587217",
            "text": "entity compare -> category primary group OR subpage group",
            "children": [],
            "x": 580,
            "parent": "1792461587219",
            "y": 11480,
            "collapsed": false
          },
          {
            "id": "1792461587218",
            "text": "a facet and an entity may coexist: 'banking' page on a city + 'bank' entities",
            "children": [],
            "x": 580,
