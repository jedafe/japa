          {
            "id": "1792461587211",
            "text": "wiki categories  (registry)",
            "children": [
              {
                "id": "1792461587205",
                "text": "overview = PRIMARY field group on every wiki type",
                "children": [],
                "x": 820,
                "parent": "1792461587211",
                "y": 10780,
                "collapsed": false
              },
              {
                "id": "1792461587206",
                "text": "category = page template bound to a field group, declared per wiki type",
                "children": [],
                "x": 820,
                "parent": "1792461587211",
                "y": 10850,
                "collapsed": false
              },
              {
                "id": "1792461587207",
                "text": "subpage = subtype with its own field group (COL subpages, tuition subpages)",
                "children": [],
                "x": 820,
                "parent": "1792461587211",
                "y": 10920,
                "collapsed": false
              },
              {
                "id": "1792461587208",
                "text": "child types inherit parent category template with per-type groups",
                "children": [],
                "x": 820,
                "parent": "1792461587211",
                "y": 10990,
                "collapsed": false
              },
              {
                "id": "1792461587209",
                "text": "facet vs entity: category = 1:1 facet page; wiki type = N instances with own pages",
                "children": [],
                "x": 820,
                "parent": "1792461587211",
                "y": 11060,
                "collapsed": false
              },
              {
                "id": "1792461587210",
                "text": "rule: one field group per (wiki type, category/subpage)",
                "children": [],
                "x": 820,
                "parent": "1792461587211",
                "y": 11130,
                "collapsed": false
              }
