{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "japaconnect": {
      "type": "remote",
      "url": "http://localhost:8080/api/v1/mcp",
      "headers": {
        "X-API-Key": "{env:JC_MCP_API_KEY}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  }
}
