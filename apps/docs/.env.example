# Server-only base URL for the Go backend (no trailing slash, no /api/v1 suffix).
PRIVATE_API_BASE_URL=http://localhost:8080

# Public API base used by browser-side fetches (the API playground). In dev
# this is proxied to the backend by vite (see vite.config.ts); in prod point
# it at the API gateway.
PUBLIC_JC_API_URL=/api/v1

# Canonical docs origin, used for SEO canonical URLs and JSON-LD.
PUBLIC_DOCS_ORIGIN=https://docs.japaconnect.com

# Main app origin — used for cross-app redirects (e.g., login from the playground).
PUBLIC_MAIN_ORIGIN=http://localhost:3000
