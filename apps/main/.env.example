# Server-only base URL for the Go backend (no trailing slash, no /api/v1 suffix).
PRIVATE_API_BASE_URL=http://localhost:8080

# Browser-facing origin of the Go API — the backend's JC_MCP_PUBLIC_URL. Only
# needed when PRIVATE_API_BASE_URL points at an internal address (k8s service,
# docker network) that differs from the public origin; used to allowlist the
# §120 MCP OAuth post-login redirect. Defaults to PRIVATE_API_BASE_URL.
# PRIVATE_API_PUBLIC_ORIGIN=https://api.japaconnect.com

# Public API base used by browser-side fetches. In dev this is proxied to the
# backend by vite (see vite.config.ts); in prod point it at the API gateway.
PUBLIC_JC_API_URL=/api/v1

# Cross-app origins for Learn / Japa Academy / Docs deep links (no trailing slash).
# Used by $lib/appOrigins for /academy/* redirects and dashboard/profile links.
PUBLIC_JC_ACADEMY_ORIGIN=https://academy.japaconnect.com
PUBLIC_DOCS_ORIGIN=https://docs.japaconnect.com

# Comma-separated extra hostnames treated as the public roadmap surface
# (ADR-127). The canonical host roadmap.japaconnect.com is always detected;
# list custom domains here (e.g. JC_ROADMAP_HOSTS=roadmap.example.com).
JC_ROADMAP_HOSTS=

# Set to 'false' in local development so http://localhost auth cookies are
# accepted by the browser and shared across ports (3000). Defaults to
# !dev (true in production, false in development) when omitted.
PRIVATE_COOKIE_SECURE=false

# Umami analytics site ID for the Main surface (§40, ROADMAP-MAIN 01.10).
# Leave empty to disable Umami tracking on this surface.
# PUBLIC_JC_UMAMI_SITE_ID=

# Umami analytics script URL (shared across surfaces, §40).
# In docker-compose this defaults to http://localhost:3010.
# PUBLIC_JC_UMAMI_URL=http://localhost:3010

# Tools surface origin for external tool links (tools.japaconnect.com in prod).
PUBLIC_JC_TOOLS_ORIGIN=https://tools.japaconnect.com
