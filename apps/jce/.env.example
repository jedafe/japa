# Server-only base URL for the Go backend (no trailing slash, no /api/v1 suffix).
PRIVATE_API_BASE_URL=http://go-api:8080

# Public API base used by browser-side fetches. In dev this is proxied to the
# backend by vite (see vite.config.ts); in prod point it at the API gateway.
PUBLIC_JC_API_URL=/api/v1

# Canonical Main app origin — owns /login, /signup, /create, /u/{username}.
# Dev: http://localhost:3000 · Prod: https://japaconnect.com
PUBLIC_MAIN_ORIGIN=http://localhost:3000

# Default picker page size and available page-size options (JSON array).
# Comparison types may override these via their own `page_size_options` config.
PUBLIC_JCE_DEFAULT_PAGE_SIZE=24
PUBLIC_JCE_DEFAULT_PAGE_SIZE_OPTIONS=[12,24,48]

# Default item ref types for the picker (JSON array) when a comparison type
# does not define `item_ref_types` or `default_item_ref_type`.
PUBLIC_JCE_DEFAULT_ITEM_REF_TYPES=["space"]

# Public comparison directory defaults.
PUBLIC_JCE_COMPARISON_LIST_PAGE_SIZE=12
PUBLIC_JCE_COMPARISON_LIST_MAX_PAGE_SIZE=100
