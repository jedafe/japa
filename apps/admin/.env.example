# --- Server-side (SSR only, read at runtime via $env/dynamic/private) ---
# Backend host WITHOUT /api/v1 — the code appends /api/v1 per call.
PRIVATE_API_BASE_URL=http://localhost:8080
# Cookie domain for auth cookies; leave unset in dev for host-only cookies.
#JC_COOKIE_DOMAIN=.japaconnect.com

# --- Client-side (baked into the bundle at BUILD time via $env/static/public) ---
PUBLIC_JC_API_URL=http://localhost:8080
PUBLIC_JC_WS_URL=ws://localhost:8080
PUBLIC_JC_ENV=development
# Public site URL for constructing external links (embed, share).
PUBLIC_JC_SITE_URL=http://localhost:5173
# Error tracking DSN; empty disables GlitchTip.
PUBLIC_JC_GLITCHTIP_DSN=

# Umami analytics site ID for the Admin surface (§40).
# Leave empty to disable Umami tracking on this surface.
# PUBLIC_JC_UMAMI_SITE_ID_ADMIN=

# Umami analytics script URL (shared across surfaces, §40).
# In docker-compose this defaults to http://localhost:3010.
# PUBLIC_JC_UMAMI_URL=http://localhost:3010
