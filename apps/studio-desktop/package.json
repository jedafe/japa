{
	"name": "@japaconnect/studio-desktop",
	"private": true,
	"version": "0.0.5",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3010",
		"build": "vite build",
		"preview": "vite preview --port 3010",
		"test": "vitest run",
		"test:e2e": "bun run build && bunx playwright test",
		"test:e2e:tauri": "bun scripts/e2e-tauri.ts",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "bun scripts/bump-version.ts && bun scripts/tauri-build.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.6.6",
		"@types/selenium-webdriver": "^4.35.7",
		"jsdom": "^31.0.0",
		"selenium-webdriver": "^4.52.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@japaconnect/ui": "workspace:*",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@tauri-apps/plugin-shell": "^2.6.0",
		"@tauri-apps/plugin-sql": "^2.6.0",
		"bits-ui": "^2.20.6",
		"isomorphic-dompurify": "^4.7.0",
		"js-yaml": "^5.5.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.1.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
