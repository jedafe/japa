{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jc_studio",
  "version": "0.0.4",
  "identifier": "com.japaconnect.studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3010",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Japa Content Studio",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "msi"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:state.db"
      ]
    }
  }
}
