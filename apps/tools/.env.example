# Server-only base URL for the Go backend (no trailing slash, no /api/v1 suffix).
PRIVATE_API_BASE_URL=http://localhost:8080

# Public API base used by browser-side fetches. In dev this is proxied to the
# backend by vite (see vite.config.ts); in prod point it at the API gateway.
PUBLIC_JC_API_URL=/api/v1

# Canonical Main app origin — owns /login, /signup, /u/{username}. Tools has no
# such routes, so auth/profile links cross over to the Main app (shared jc_token
# cookie). Dev: http://localhost:3000 · Prod: https://japaconnect.com
PUBLIC_MAIN_ORIGIN=http://localhost:3000

# Umami analytics site ID for the Tools surface (§40, §78).
# Leave empty to disable Umami tracking on this surface.
# PUBLIC_JC_UMAMI_SITE_ID_TOOLS=

# Umami analytics script URL (shared across surfaces, §40).
# In docker-compose this defaults to http://localhost:3010.
# PUBLIC_JC_UMAMI_URL=http://localhost:3010

# ADR-086: comma-separated list of additional hosts (besides the canonical
# tools.japaconnect.com) that should render the tools hub shell. Per-tool
# subdomains and custom domains are resolved from system_settings at runtime.
# JC_TOOLS_HUB_HOSTS=tools.example.com
