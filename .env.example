# .env.example — copy to .env and fill in values for local development.
# Every variable uses the JC_ prefix so JapaConnect settings are easy to
# identify in any environment. Do not commit .env — it contains secrets.

# ── Core Infrastructure ────────────────────────────────────────────────

# PostgreSQL connection string for the primary database (writes go here).
JC_DATABASE_URL=postgresql://japa:japa@postgres:5432/japa?sslmode=disable

# Read replica connection string. When set, SELECT queries use the replica;
# INSERT/UPDATE/DELETE still use JC_DATABASE_URL. Leave empty to disable.
JC_DATABASE_READER_URL=postgresql://japa:japa@postgres-replica:5432/japa?sslmode=disable

# Valkey (Redis-protocol) address for cache and Asynq task queues.
# JC_VALKEY_ADDR is the canonical name (JEOS stack.yaml); JC_REDIS_ADDR is a
# legacy alias still read as a fallback.
JC_VALKEY_ADDR=valkey:6379
JC_REDIS_ADDR=valkey:6379

# Valkey connection tuning (all optional).
JC_REDIS_PASSWORD=
JC_REDIS_DB=0
JC_REDIS_POOL_SIZE=
JC_REDIS_TLS_ENABLED=false
JC_REDIS_DIAL_TIMEOUT_MS=
JC_REDIS_READ_TIMEOUT_MS=

# PostgreSQL connection pool tuning (all optional).
JC_DB_MIN_CONNS=
JC_DB_MAX_CONNS=
JC_DB_MAX_CONN_LIFETIME_MS=
JC_DB_MAX_CONN_IDLE_TIME_MS=

# Meilisearch HTTP endpoint and master key (empty for dev).
JC_MEILISEARCH_URL=http://meilisearch:7700
JC_MEILISEARCH_KEY=

# Optional prefix applied to every Meilisearch index UID (e.g. "staging_").
# Lets a non-production environment share one Meilisearch instance without
# index collisions. Empty = no prefix (use this in production).
JC_MEILI_INDEX_PREFIX=

# ── GeoIP ──────────────────────────────────────────────────────────────

# MaxMind GeoIP database path and license key for GeoLite2 downloads.
# Account ID is required alongside the license key for download auth.
JC_GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
JC_MAXMIND_LICENSE_KEY=
JC_MAXMIND_ACCOUNT_ID=

# ── Engineering Spec Corpus (§121) ─────────────────────────────────────

# Root of the vendored JEOS spec tree indexed as private spec_doc chunks
# for the staff-only spec.search agent tool. Resolved relative to the API
# binary working dir; empty = ".jeos".
JC_SPEC_CORPUS_DIR=

# ── Error Tracking ─────────────────────────────────────────────────────

# Glitchtip (Sentry-compatible) DSN for error reporting.
JC_GLITCHTIP_DSN=

# ── Image Processing ───────────────────────────────────────────────────

# imgproxy signing key, salt, and base URL for image processing.
JC_IMGPROXY_KEY=
JC_IMGPROXY_SALT=
JC_IMGPROXY_BASE_URL=http://imgproxy:8080
# Internal URL the API uses server-side when it differs from the public base.
JC_IMGPROXY_INTERNAL_URL=

# ── Agent Memory ───────────────────────────────────────────────────────

# Honcho agent memory service URL. Uncomment and point at your deployment —
# when unset the API skips AI-context features entirely (graceful). Setting
# this to an unreachable host makes GDPR erasure fail closed in production.
# JC_HONCHO_URL=http://honcho:8001

# Daily sweep deletes Honcho context entries older than this many days.
# 0 disables retention (entries kept forever). Only meaningful when JC_HONCHO_URL is set.
JC_HONCHO_RETENTION_DAYS=90

# ── Virus Scanning ─────────────────────────────────────────────────────

# ClamAV daemon address (host:port).
JC_CLAMAV_ADDR=localhost:3310

# ── App Identity ───────────────────────────────────────────────────────

# Git commit SHA for release tracking (set by CI, "dev" for local).
JC_RELEASE_SHA=dev

# Optional override for the deployment version shown in the control panel.
# If unset, the version embedded at build time is used.
JC_DEPLOYMENT_VERSION=

# Environment: "development" or "production".
JC_ENV=development

# HTTP port the API listens on.
JC_PORT=8080

# Site name for LLMS.txt and branding.
# JC_SITE_TITLE is a legacy alias still read as a fallback for JC_SITE_NAME.
JC_SITE_NAME=Japa.to
JC_SITE_TITLE=

# Public-facing base URL of the main site (e.g. https://example.com).
# In local dev this is the frontend app (apps/main), NOT the API host —
# OAuth login redirects, MCP search/fetch result links, and llms.txt URLs
# are built from it and must land on real pages.
JC_SITE_URL=http://localhost:3000

# Site description for LLMS.txt.
JC_SITE_DESCRIPTION=A community platform for the Nigerian diaspora and Nigerians planning to relocate abroad

# ── Umami Analytics (Section 40, ADR-040) ──────────────────────────────

# Self-hosted Umami URL reachable from the browser. In local dev with
# docker-compose this is http://localhost:3010; in production use the
# canonical analytics endpoint (e.g. https://analytics.japa.to).
PUBLIC_JC_UMAMI_URL=http://localhost:3010

# Per-surface Umami website IDs. Each surface needs its own site in Umami.
# Leave empty to disable Umami injection for that surface.
PUBLIC_JC_UMAMI_SITE_ID=
PUBLIC_JC_UMAMI_SITE_ID_TOOLS=
PUBLIC_JC_UMAMI_SITE_ID_ADMIN=
PUBLIC_JC_UMAMI_SITE_ID_CONTROL=
PUBLIC_JC_UMAMI_SITE_ID_ACADEMY=
PUBLIC_JC_UMAMI_SITE_ID_DOCS=

# Secret key for Umami's JWT/session signing (Docker Compose only).
JC_UMAMI_APP_SECRET=dev-umami-secret-change-me

# ── Authentication & Sessions ──────────────────────────────────────────

# JWT signing secret (optional — if empty, a random key is generated at startup
# and sessions won't persist across restarts). Set to a strong random string
# (at least 32 bytes) for production deployments.
JC_JWT_SECRET=

# Key ID for the JWT kid header (defaults to "key-dev" if not set).
JC_JWT_KEY_ID=key-dev

# AES-256 key for encrypting secrets at rest (TOTP secrets, provider API keys,
# remittance/travel api_config). JEOS canonical env var name.
JC_ENCRYPTION_KEY=

# Legacy alias for JC_ENCRYPTION_KEY (kept for backward compatibility).
JC_TOTP_ENCRYPTION_KEY=

# ── OAuth Providers ────────────────────────────────────────────────────

# Google OAuth
JC_OAUTH_GOOGLE_CLIENT_ID=
JC_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
JC_OAUTH_GITHUB_CLIENT_ID=
JC_OAUTH_GITHUB_CLIENT_SECRET=

# Apple Sign-In
JC_OAUTH_APPLE_CLIENT_ID=
JC_OAUTH_APPLE_TEAM_ID=
JC_OAUTH_APPLE_KEY_ID=
JC_OAUTH_APPLE_PRIVATE_KEY_PATH=

# Facebook OAuth
JC_OAUTH_FACEBOOK_APP_ID=
JC_OAUTH_FACEBOOK_APP_SECRET=

# Base URL for OAuth callbacks (e.g. https://api.example.com).
JC_OAUTH_REDIRECT_BASE=http://localhost:8080

# ── AI Providers ───────────────────────────────────────────────────────

# Xiaomi MiMo API key (tp- for Token Plan, sk- for Pay-as-you-go).
JC_XIAOMI_API_KEY=

# ── Payment Providers ──────────────────────────────────────────────────

# Stripe API secret key (sk_live_... / sk_test_...). When set in production,
# JC_STRIPE_WEBHOOK_SECRET is mandatory — webhooks cannot go unverified.
JC_STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...).
JC_STRIPE_WEBHOOK_SECRET=

# NOWPayments IPN HMAC secret.
JC_NOWPAYMENTS_IPN_SECRET=

# NOWPayments API key (optional; falls back to JC_NOWPAYMENTS_IPN_SECRET).
# Used for outbound crypto payouts.
JC_NOWPAYMENTS_API_KEY=

# Paystack secret key.
JC_PAYSTACK_SECRET_KEY=

# ── CORS & Cookies ─────────────────────────────────────────────────────

# Comma-separated allowed CORS origins for production. Also used as the
# allowlist for WebSocket upgrade requests.
JC_CORS_ORIGINS=

# Public WebSocket endpoint for real-time updates. When set, the browser
# connects directly instead of using the same-origin /api/v1/ws path.
# Local example: ws://localhost:8080/api/v1/ws
PUBLIC_JC_WS_URL=

# Comma-separated CIDRs (or bare IPs) of reverse proxies allowed to set
# X-Forwarded-For / X-Real-IP. Requests from anywhere else are attributed to
# their TCP peer, so brute-force lockouts, IP blocks and API-key IP allowlists
# cannot be bypassed with a forged header. Defaults to loopback + RFC1918.
JC_TRUSTED_PROXIES=

# Cookie domain for cross-subdomain session sharing.
# Must be set in production (e.g. ".japa.to") so the session cookie
# is shared across api.japa.to and app.japa.to.
JC_COOKIE_DOMAIN=.japa.to

# ── Surface Host Detection (SvelteKit apps) ────────────────────────────

# Base domain the frontend hooks use to derive canonical surface hosts
# (tools.<domain>, academy.<domain>, roadmap.<domain>, and per-tool
# subdomains). Defaults to japa.to — set to e.g.
# staging.japa.to on staging deployments. Read via
# $env/dynamic/private by apps/main and apps/tools.
JC_BASE_DOMAIN=

# Comma-separated extra hosts for branded surfaces (custom domains like
# japauni.com); canonical <surface>.<JC_BASE_DOMAIN> hosts always match.
JC_TOOLS_HUB_HOSTS=
JC_ACADEMY_HOSTS=
JC_ROADMAP_HOSTS=

# ── Internal Services ──────────────────────────────────────────────────

# Shared secret for internal service-to-service endpoints (render helpers).
JC_INTERNAL_TOKEN=

# ── Test Only ──────────────────────────────────────────────────────────

# PostgreSQL connection string for the test database (used by go test
# integration tests via internal/testdb). Defaults to the primary database
# with _test suffix if unset. Not required for unit tests.
JC_TEST_DATABASE_URL=postgresql://japa:japa@postgres:5432/japa_test?sslmode=disable

# ── Stock Photo Integration (Section 34) ───────────────────────────────

# Unsplash API access key (https://unsplash.com/developers).
JC_UNSPLASH_ACCESS_KEY=

# Pexels API key (https://www.pexels.com/api/).
JC_PEXELS_API_KEY=

# Pixabay API key (https://pixabay.com/api/docs/).
JC_PIXABAY_API_KEY=

# Search result cache TTL in seconds (default 300 = 5 minutes).
JC_STOCK_CACHE_TTL_SECONDS=300

# Maximum cached search result pages before LRU eviction (default 1000).
JC_STOCK_CACHE_MAX_ENTRIES=1000

# Provider HTTP client timeout in seconds (default 15).
JC_STOCK_HTTP_TIMEOUT_SECONDS=15

# ── Agent Tooling / MCP ─────────────────────────────────────────────

# API key for the local MCP endpoint (http://localhost:8080/api/v1/mcp).
# Referenced as ${JC_MCP_API_KEY} in .mcp.json (Claude Code / CommandCode)
# and {env:JC_MCP_API_KEY} in opencode.jsonc so coding agents can call the
# japaconnect MCP server. Generate one via the admin API-keys flow.
JC_MCP_API_KEY=

# Public base URL advertised in MCP OAuth discovery metadata (§120).
# Issuer for /oauth/* endpoints and /.well-known/oauth-* documents, and the
# base of the `resource` URI in oauth-protected-resource. Falls back to
# JC_OAUTH_REDIRECT_BASE, then JC_SITE_URL — set it explicitly whenever
# JC_SITE_URL points at the frontend (which it always should). Must be
# HTTPS in production.
# JC_MCP_PUBLIC_URL=https://api.japa.to
JC_MCP_PUBLIC_URL=http://localhost:8080

# ── Email (SMTP) ────────────────────────────────────────────────────────

# SMTP relay for transactional email (required in production).
JC_SMTP_HOST=
JC_SMTP_PORT=587
JC_SMTP_USER=
JC_SMTP_PASS=
JC_SMTP_FROM=

# ── Object Storage (SeaweedFS / S3-compatible) ──────────────────────────

# S3-compatible endpoint for media storage (SeaweedFS per ADR-048).
# Leave empty when running the bundled SeaweedFS service.
JC_S3_ENDPOINT=
JC_S3_REGION=
JC_S3_BUCKET=
JC_S3_ACCESS_KEY=
JC_S3_SECRET_KEY=

# Local media root for non-S3 storage backends (dev fallback).
JC_MEDIA_ROOT=

# ── Push Notifications (WebPush VAPID) ─────────────────────────────────

# VAPID keys for Web Push. All three required; when incomplete in
# production, push is disabled and a warning is logged (push.enabled flag
# remains the on/off switch — Control → Extensions).
JC_VAPID_PUBLIC_KEY=
JC_VAPID_PRIVATE_KEY=
JC_VAPID_SUBJECT=mailto:ops@example.com

# ── Newsletter ──────────────────────────────────────────────────────────

# HMAC secret for the inbound provider webhook at POST /newsletter/webhook.
JC_NEWSLETTER_WEBHOOK_SECRET=

# Weekly digest schedule (UTC). Day: 0=Sunday..6=Saturday.
JC_NEWSLETTER_DIGEST_DAY=0
JC_NEWSLETTER_DIGEST_HOUR_UTC=8

# ── Webhooks ────────────────────────────────────────────────────────────

# DEV ONLY — set "true" to accept unsigned payment webhooks locally.
# Never set in production; signature verification is mandatory there.
JC_ALLOW_UNSIGNED_WEBHOOKS=false

# ── Content Renderer (OG images / export) ───────────────────────────────

# Path to the bundled renderer scripts and its tuning knobs.
JC_RENDERER_SCRIPT_ROOT=
JC_RENDERER_TIMEOUT=
JC_RENDERER_MAX_CONCURRENT=
JC_RENDERER_CACHE_TTL=

# Directory where the sitemap:generate task writes rendered XML files.
JC_SITEMAP_DIR=./sitemaps

# ── Background Worker ──────────────────────────────────────────────────

# Asynq queue concurrency per tier (optional; defaults shown).
JC_WORKER_CRITICAL_CONCURRENCY=
JC_WORKER_DEFAULT_CONCURRENCY=
JC_WORKER_LOW_CONCURRENCY=

# Per-task cron override: JC_SCHEDULER_CRON_<TASK_TYPE> where TASK_TYPE is
# the task name uppercased with : -> _. Example:
#   JC_SCHEDULER_CRON_CONTENT_PUBLISH_SWEEP="*/2 * * * *"

# Set JC_SCHEDULER_ENABLED=0 on extra api replicas — the Asynq scheduler must
# run in exactly one process or periodic tasks enqueue once per replica.
JC_SCHEDULER_ENABLED=

# Set JC_HTTP_ENABLED=0 for a worker-only node (no HTTP listener). Pair with
# scheduler=1 on one worker replica, api replicas get scheduler=0.
JC_HTTP_ENABLED=

# ── Seeding / Bootstrap ────────────────────────────────────────────────

# Admin seed credentials. JC_SEED_ADMIN_PASSWORD is REQUIRED in production —
# seed refuses to fall back to a default there.
JC_SEED_ADMIN_EMAIL=admin@japa.to
JC_SEED_ADMIN_PASSWORD=

# Live-seed / live-API test gates (unit-test opt-ins; never set in normal runs):
#   JC_SEED_LIVE=1, JC_SEED_UPSTREAM=1, JC_OLLAMA_CLOUD_API_KEY=<key>

# ── Misc Integrations ──────────────────────────────────────────────────

# YouTube Data API key (video channel sync / import — §106).
JC_YOUTUBE_API_KEY=

# Comma-separated extra CORS response headers appended to the default list.
JC_CORS_HEADERS=

# Previous AES-256 key for encryption-at-rest key rotation. Set only during
# rotation so old ciphertext stays decryptable while new writes use
# JC_ENCRYPTION_KEY.
JC_ENCRYPTION_KEY_PREVIOUS=

# Legacy alias in the stock-photo encryption fallback chain
# (JC_ENCRYPTION_KEY → JC_STOCK_ENCRYPTION_KEY → JC_TOTP_ENCRYPTION_KEY).
JC_STOCK_ENCRYPTION_KEY=

# ── MCP Bridge CLI (cmd/mcpbridge) ──────────────────────────────────────

# Endpoint + token for the local MCP stdio bridge. Operator tooling only —
# not required by the API server.
JC_MCP_URL=
JC_MCP_TOKEN=
