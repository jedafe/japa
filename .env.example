# .env.example — copy to .env and fill in values for local development.
# Every variable uses the JC_ prefix so JapaConnect settings are easy to
# identify in any environment. Do not commit .env — it contains secrets.

# ── Core Infrastructure ────────────────────────────────────────────────

# PostgreSQL connection string for the primary database (writes go here).
JC_DATABASE_URL=postgresql://japa:japa@postgres:5432/japa?sslmode=disable

# Read replica connection string. When set, SELECT queries use the replica;
# INSERT/UPDATE/DELETE still use JC_DATABASE_URL. Leave empty to disable.
JC_DATABASE_READER_URL=postgresql://japa:japa@postgres-replica:5432/japa?sslmode=disable

# Valkey (Redis-protocol) address for cache and Asynq task queues.
JC_REDIS_ADDR=valkey:6379

# Meilisearch HTTP endpoint and master key (empty for dev).
JC_MEILISEARCH_URL=http://meilisearch:7700
JC_MEILISEARCH_KEY=

# ── GeoIP ──────────────────────────────────────────────────────────────

# MaxMind GeoIP database path and license key for GeoLite2 downloads.
JC_GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
JC_MAXMIND_LICENSE_KEY=

# ── Error Tracking ─────────────────────────────────────────────────────

# Glitchtip (Sentry-compatible) DSN for error reporting.
JC_GLITCHTIP_DSN=

# ── Image Processing ───────────────────────────────────────────────────

# imgproxy signing key, salt, and base URL for image processing.
JC_IMGPROXY_KEY=
JC_IMGPROXY_SALT=
JC_IMGPROXY_BASE_URL=http://imgproxy:8080

# ── Agent Memory ───────────────────────────────────────────────────────

# Honcho agent memory service URL.
JC_HONCHO_URL=http://honcho:8001

# ── Virus Scanning ─────────────────────────────────────────────────────

# ClamAV daemon address (host:port).
JC_CLAMAV_ADDR=localhost:3310

# ── App Identity ───────────────────────────────────────────────────────

# Git commit SHA for release tracking (set by CI, "dev" for local).
JC_RELEASE_SHA=dev

# Optional override for the deployment version shown in the control panel.
# If unset, the version embedded at build time is used.
JC_DEPLOYMENT_VERSION=

# Environment: "development" or "production".
JC_ENV=development

# HTTP port the API listens on.
JC_PORT=8080

# Site name for LLMS.txt and branding.
JC_SITE_NAME=JapaConnect

# Public-facing base URL (e.g. https://example.com).
JC_SITE_URL=http://localhost:8080

# Site description for LLMS.txt.
JC_SITE_DESCRIPTION=A community platform for the Nigerian diaspora and Nigerians planning to relocate abroad

# ── Umami Analytics (Section 40, ADR-040) ──────────────────────────────

# Self-hosted Umami URL reachable from the browser. In local dev with
# docker-compose this is http://localhost:3010; in production use the
# canonical analytics endpoint (e.g. https://analytics.japaconnect.com).
PUBLIC_JC_UMAMI_URL=http://localhost:3010

# Per-surface Umami website IDs. Each surface needs its own site in Umami.
# Leave empty to disable Umami injection for that surface.
PUBLIC_JC_UMAMI_SITE_ID=
PUBLIC_JC_UMAMI_SITE_ID_TOOLS=
PUBLIC_JC_UMAMI_SITE_ID_ADMIN=
PUBLIC_JC_UMAMI_SITE_ID_CONTROL=
PUBLIC_JC_UMAMI_SITE_ID_LEARN=
PUBLIC_JC_UMAMI_SITE_ID_DOCS=

# Secret key for Umami's JWT/session signing (Docker Compose only).
JC_UMAMI_APP_SECRET=dev-umami-secret-change-me

# ── Authentication & Sessions ──────────────────────────────────────────

# JWT signing secret (optional — if empty, a random key is generated at startup
# and sessions won't persist across restarts). Set to a strong random string
# (at least 32 bytes) for production deployments.
JC_JWT_SECRET=

# Key ID for the JWT kid header (defaults to "key-dev" if not set).
JC_JWT_KEY_ID=key-dev

# AES-256 key for encrypting secrets at rest (TOTP secrets, provider API keys,
# remittance/travel api_config). JEOS canonical env var name.
JC_ENCRYPTION_KEY=

# Legacy alias for JC_ENCRYPTION_KEY (kept for backward compatibility).
JC_TOTP_ENCRYPTION_KEY=

# ── OAuth Providers ────────────────────────────────────────────────────

# Google OAuth
JC_OAUTH_GOOGLE_CLIENT_ID=
JC_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
JC_OAUTH_GITHUB_CLIENT_ID=
JC_OAUTH_GITHUB_CLIENT_SECRET=

# Apple Sign-In
JC_OAUTH_APPLE_CLIENT_ID=
JC_OAUTH_APPLE_TEAM_ID=
JC_OAUTH_APPLE_KEY_ID=
JC_OAUTH_APPLE_PRIVATE_KEY_PATH=

# Facebook OAuth
JC_OAUTH_FACEBOOK_APP_ID=
JC_OAUTH_FACEBOOK_APP_SECRET=

# Base URL for OAuth callbacks (e.g. https://api.example.com).
JC_OAUTH_REDIRECT_BASE=http://localhost:8080

# ── AI Providers ───────────────────────────────────────────────────────

# Xiaomi MiMo API key (tp- for Token Plan, sk- for Pay-as-you-go).
JC_XIAOMI_API_KEY=

# ── Payment Providers ──────────────────────────────────────────────────

# Stripe webhook signing secret (whsec_...).
JC_STRIPE_WEBHOOK_SECRET=

# NOWPayments IPN HMAC secret.
JC_NOWPAYMENTS_IPN_SECRET=

# NOWPayments API key (optional; falls back to JC_NOWPAYMENTS_IPN_SECRET).
# Used for outbound crypto payouts.
JC_NOWPAYMENTS_API_KEY=

# Paystack secret key.
JC_PAYSTACK_SECRET_KEY=

# ── CORS & Cookies ─────────────────────────────────────────────────────

# Comma-separated allowed CORS origins for production. Also used as the
# allowlist for WebSocket upgrade requests.
JC_CORS_ORIGINS=

# Public WebSocket endpoint for real-time updates. When set, the browser
# connects directly instead of using the same-origin /api/v1/ws path.
# Local example: ws://localhost:8080/api/v1/ws
PUBLIC_JC_WS_URL=

# Comma-separated CIDRs (or bare IPs) of reverse proxies allowed to set
# X-Forwarded-For / X-Real-IP. Requests from anywhere else are attributed to
# their TCP peer, so brute-force lockouts, IP blocks and API-key IP allowlists
# cannot be bypassed with a forged header. Defaults to loopback + RFC1918.
JC_TRUSTED_PROXIES=

# Cookie domain for cross-subdomain session sharing.
# Must be set in production (e.g. ".japaconnect.com") so the session cookie
# is shared across api.japaconnect.com and app.japaconnect.com.
JC_COOKIE_DOMAIN=.japaconnect.com

# ── Internal Services ──────────────────────────────────────────────────

# Shared secret for internal service-to-service endpoints (render helpers).
JC_INTERNAL_TOKEN=

# ── Test Only ──────────────────────────────────────────────────────────

# PostgreSQL connection string for the test database (used by go test
# integration tests via internal/testdb). Defaults to the primary database
# with _test suffix if unset. Not required for unit tests.
JC_TEST_DATABASE_URL=postgresql://japa:japa@postgres:5432/japa_test?sslmode=disable

# ── Stock Photo Integration (Section 34) ───────────────────────────────

# Unsplash API access key (https://unsplash.com/developers).
JC_UNSPLASH_ACCESS_KEY=

# Pexels API key (https://www.pexels.com/api/).
JC_PEXELS_API_KEY=

# Pixabay API key (https://pixabay.com/api/docs/).
JC_PIXABAY_API_KEY=

# Search result cache TTL in seconds (default 300 = 5 minutes).
JC_STOCK_CACHE_TTL_SECONDS=300

# Maximum cached search result pages before LRU eviction (default 1000).
JC_STOCK_CACHE_MAX_ENTRIES=1000

# Provider HTTP client timeout in seconds (default 15).
JC_STOCK_HTTP_TIMEOUT_SECONDS=15

# ── Agent Tooling / MCP ─────────────────────────────────────────────

# API key for the local MCP endpoint (http://localhost:8080/api/v1/mcp).
# Referenced as ${JC_MCP_API_KEY} in .mcp.json (Claude Code / CommandCode)
# and {env:JC_MCP_API_KEY} in opencode.jsonc so coding agents can call the
# japaconnect MCP server. Generate one via the admin API-keys flow.
JC_MCP_API_KEY=

# Public base URL advertised in MCP OAuth discovery metadata (§120).
# Issuer for /oauth/* endpoints and /.well-known/oauth-* documents, and the
# base of the `resource` URI in oauth-protected-resource. Falls back to
# JC_OAUTH_REDIRECT_BASE, then JC_SITE_URL. Must be HTTPS in production.
# JC_MCP_PUBLIC_URL=https://api.japaconnect.com
