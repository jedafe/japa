    "/public/trending/content": {
      "get": {
        "description": "Retrieve trending content snapshots scored by recent engagement.",
        "parameters": [
          {
            "description": "Number of results to return.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Time window for the trending snapshot.",
            "in": "query",
            "name": "window",
            "schema": {
              "default": "24h",
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Geo code filter for geo-aware trending (ADR-064). Omit for global ranking.",
            "in": "query",
            "name": "geo",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "computed_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/TrendingItem"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Trending snapshot"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "summary": "Trending content",
        "tags": [
          "Trending"
        ]
      }
    },
