{
  "components": {
    "responses": {
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Resource not found"
      },
      "RateLimited": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Rate limit exceeded",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "description": "Maximum requests per minute for this tier",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "description": "Remaining requests in the current window",
            "schema": {
              "type": "integer"
            }
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Missing or invalid API key"
      }
    },
    "schemas": {
      "Comment": {
        "properties": {
          "author_id": {
            "format": "uuid",
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "content_id": {
            "format": "uuid",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "parent_id": {
            "description": "Parent comment ID for nested replies",
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Content": {
        "properties": {
          "author_id": {
            "format": "uuid",
            "type": "string"
          },
          "content_type": {
            "enum": [
              "post",
              "article",
              "guide"
            ],
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "read_time": {
            "description": "Estimated read time in minutes",
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "space_id": {
            "format": "uuid",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Machine-readable error code",
                "type": "string"
              },
              "docs": {
                "description": "Link to error documentation",
                "format": "uri",
                "type": "string"
              },
              "message": {
                "description": "Human-readable error message",
                "type": "string"
              },
              "status": {
                "description": "HTTP status code",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "Space": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "member_count": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "country",
              "state",
              "city",
              "university",
              "custom",
              "global"
            ]
          },
          "is_primary": {
            "type": "boolean"
          },
          "follower_count": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Tag": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "post_count": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TrendingItem": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "meta": {
            "description": "Additional metadata varies by entity type",
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "description": "Trending score",
            "format": "float",
            "type": "number"
          },
          "slug": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "User": {
        "properties": {
          "avatar_url": {
            "format": "uri",
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "API key obtained from the Developer Portal. Prefixed with jc_live_ (production) or jc_test_ (sandbox).",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "email": "api@localhost:8080",
      "name": "Japa.to Developer Support",
      "url": "http://localhost:8080/docs"
    },
    "description": "Public API for the JapaConnect platform. Requires API key authentication via the X-API-Key header.",
    "title": "Japa.to Public API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/public/content": {
      "get": {
        "description": "Retrieve a paginated list of published, public content. Drafts, scheduled, and private content are never exposed.",
        "parameters": [
          {
            "description": "Number of results to return.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of results to skip for pagination.",
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Content"
                      },
                      "type": "array"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "List of published content"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "summary": "List published content",
        "tags": [
          "Content"
        ]
      }
    },
    "/public/content/{id}": {
      "get": {
        "description": "Retrieve a single published content item by its unique identifier.",
        "parameters": [
          {
            "description": "Content ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Content"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Content details"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "summary": "Get content detail",
        "tags": [
          "Content"
        ]
      }
    },
