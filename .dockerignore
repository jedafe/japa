# .dockerignore — exclude files from the Docker build context so builds
# are faster and the image does not contain unnecessary or sensitive files.

# Go build artifacts
bin/
*.exe
*.test
*.out

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files (never bake secrets into images)
.env
.env.local
.env.*.local

# Docker
docker-compose.yml
Dockerfile
.dockerignore

# Data volumes
data/
postgres-data/
valkey-data/
meili-data/
minio-data/

# Node (SvelteKit apps, not needed for Go API build)
node_modules/
.svelte-kit/
dist/
build/

# OS files
.DS_Store
Thumbs.db

# AI memory and docs (not needed in the runtime image)
ai-memory/
Prompts/
