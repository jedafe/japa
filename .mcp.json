{
  "mcpServers": {
    "japaconnect": {
      "type": "http",
      "url": "http://localhost:8080/api/v1/mcp",
      "headers": {
        "X-API-Key": "${JC_MCP_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "bunx",
      "args": ["@playwright/mcp@latest"]
    },
    "context7": {
      "type": "stdio",
      "command": "bunx",
      "args": ["@upstash/context7-mcp"]
    }
  }
}
